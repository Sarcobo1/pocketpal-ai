+// The chat runs its one slot on sequence 0, so 1 is the id an utterance can be
+// given and taken back again without touching what the conversation holds.
+constexpr llama_seq_id SPEECH_SEQ_ID = 1;
+
+// Takes the utterance's own cells out of the memory on every exit path, so the
+// caller does not have to clear the whole cache to be safe after speaking.
+struct scoped_speech_seq {
+    llama_context * ctx = nullptr;
+    llama_seq_id seq = -1;
+    void hold(llama_context * c, llama_seq_id s) {
+        ctx = c;
+        seq = s;
+    }
+    ~scoped_speech_seq() {
+        if (ctx != nullptr && seq >= 0) {
+            llama_memory_seq_rm(llama_get_memory(ctx), seq, 0, -1);
+        }
+    }
+};
+
+// One speech call at a time holds the log sink (a ContextClaim serializes them),
+// so a bare global is enough to route the engine's words into its result.
+std::string * g_speech_log = nullptr;
+
+void speech_log_capture(enum ggml_log_level level, const char * text, void * /*user_data*/) {
+    if (g_speech_log == nullptr || text == nullptr) {
+        return;
+    }
+    // The engine is chatty at info; only what it blames the failure on is kept.
+    if (level != GGML_LOG_LEVEL_WARN && level != GGML_LOG_LEVEL_ERROR) {
+        return;
+    }
+    // One line: the caller prints this inside a key=value log line.
+    for (const char * p = text; *p != '\0' && g_speech_log->size() < 600; p++) {
+        if (*p == '\n' || *p == '\r') {
+            if (!g_speech_log->empty() && g_speech_log->back() != ' ') {
+                g_speech_log->push_back(' ');
+            }
+            continue;
+        }
+        g_speech_log->push_back(*p);
+    }
+}
+
+// The loggers are global. llama has a getter, so it is saved and put back
+// exactly; the mtmd helper does not, and llama.rn never sets it, so restoring
+// the library's own default returns it to where it started. The helper's own
+// LOG_ERR ("prompt decode failed") goes through mtmd_helper_log_set, not
+// mtmd_log_set, so that is the one to attach.
+struct scoped_speech_log {
+    ggml_log_callback prev_llama = nullptr;
+    void * prev_llama_ud = nullptr;
+    bool attached = false;
+
+    explicit scoped_speech_log(std::string * sink) {
+        if (sink == nullptr || g_speech_log != nullptr) {
+            return;
+        }
+        llama_log_get(&prev_llama, &prev_llama_ud);
+        g_speech_log = sink;
+        llama_log_set(speech_log_capture, nullptr);
+        mtmd_helper_log_set(speech_log_capture, nullptr);
+        attached = true;
+    }
+
+    ~scoped_speech_log() {
+        if (!attached) {
+            return;
+        }
+        llama_log_set(prev_llama, prev_llama_ud);
+        mtmd_helper_log_set(nullptr, nullptr);
+        g_speech_log = nullptr;
+    }
+
+    scoped_speech_log(const scoped_speech_log &) = delete;
+    scoped_speech_log & operator=(const scoped_speech_log &) = delete;
+};
+
+} // namespace
+
+llama_rn_speech_result llama_rn_context::generate_speech(
+        const llama_rn_speech_options & opts,
+        const speech_chunk_fn & on_chunk) {
+    llama_rn_speech_result res;
+    const int64_t call_start = speech_now_us();
+    // What each frame decoded, routed the way the caller asked: kept in one
+    // buffer for a whole-clip caller, or handed out as it lands. `pending` is
+    // the audio gathered since the last callback.
+    std::vector<float> pending;
+    // Every single frame's own length, kept so the caller can tell a slow engine
+    // apart from one that stalls: the mean of these cannot tell them apart.
+    std::vector<int64_t> frame_times;
+    auto emit = [&](const float * src, int64_t n) {
+        if (n <= 0) {
+            return;
+        }
+        if (res.first_audio_us == 0) {
+            res.first_audio_us = speech_now_us() - call_start;
+        }
+        res.samples += n;
+        if (!opts.stream || !on_chunk) {
+            res.pcm.insert(res.pcm.end(), src, src + n);
+            return;
+        }
+        pending.insert(pending.end(), src, src + n);
+        const int64_t want = (int64_t) ((double) opts.chunk_seconds *
+                                        (double) std::max(1, res.sample_rate));
+        if (want > 0 && (int64_t) pending.size() >= want) {
+            on_chunk(std::move(pending), res.sample_rate);
+            pending.clear();
+            res.chunks++;
+        }
+    };
+    scoped_speech_log slog(&res.error);
+    // mtmd answers whether this projector can speak; isMultimodalEnabled() is
+    // what guarantees the mtmd_context the calls below dereference.
+    if (!isMultimodalEnabled() || ctx == nullptr || !isMultimodalSupportAudioGen()) {
+        res.stop_reason = "unsupported";
+        res.stage = "no-audio-gen";
+        return res;
+    }
+    if (opts.text.empty()) {
+        res.stop_reason = "failed";
+        res.stage = "empty-text";
+        return res;
+    }
+    // Only the model's own "tts" template ends the prompt with the speech-start
+    // token, which is the token the pipeline reads the mode off.
+    res.prompt = common_chat_get_tts_prompt(templates.get(), opts.text, opts.language, opts.voice);
+    if (res.prompt.empty()) {
+        res.stop_reason = "no-tts-template";
+        res.stage = "tts-prompt";
+        return res;
+    }
+    res.stage = "pipeline-init";
+
+    mtmd_helper_gen_audio * gen = mtmd_helper_gen_audio_init(ctx, mtmd_wrapper->mtmd_ctx);
+    mtmd_helper_gen_audio_inp inp = mtmd_helper_gen_audio_inp_default();
+    inp.stream     = true;   // pull each frame as it lands, for the per-frame timing
+    // Sequence 0 keeps the old behavior: the utterance decodes over the
+    // positions the conversation owns. A caller that wants its prefix back asks
+    // for a sequence of its own and gets only that one removed again.
+    inp.seq_id     = opts.isolate_seq ? SPEECH_SEQ_ID : 0;
+    inp.prompt     = res.prompt.data();
+    inp.prompt_len = res.prompt.size();
+    inp.n_past     = 0;      // a stand-alone utterance, not a continuation
+    inp.out_mode   = MTMD_HELPER_GEN_AUDIO_OUT_AUTO;
+    inp.speaker_ref = nullptr;
+    inp.lang       = opts.language.empty() ? nullptr : opts.language.c_str();
+    inp.voice      = opts.voice.empty() ? nullptr : opts.voice.c_str();
+    inp.seed       = opts.seed;
+    inp.out_type   = MTMD_HELPER_GEN_AUDIO_OUTTYPE_PCM;
+
+    // init always allocates: a projector without a gen pipeline fails here.
+    if (mtmd_helper_gen_audio_set_input(gen, &inp) != 0) {
+        mtmd_helper_gen_audio_free(gen);
+        res.stop_reason = "unsupported";
+        res.stage = "set-input";
+        return res;
+    }
+    scoped_speech_session session{this, gen};
+    speech_interrupted.store(false);
+    speech_active.store(true);
+    // Whatever ends this utterance — eos, an abort, a frame that failed — the
+    // cells it wrote on its own sequence go back the way they came.
+    scoped_speech_seq seq_guard;
+    if (opts.isolate_seq) {
+        seq_guard.hold(ctx, SPEECH_SEQ_ID);
+        res.seq_isolated = true;
+    }
+    // The utterance decodes over the positions the chat's own prefix owns, so
+    // the caller clears the cache once this returns.
+    scoped_speech_embeddings embeddings(ctx);
+
+    auto prefill = [&]() {
+        for (;;) {
+            const int32_t left = mtmd_helper_gen_audio_step_prompt(gen, std::max(1, params.n_batch));
+            if (left == 0) {
+                return true;
+            }
+            if (left < 0 || speech_interrupted.load()) {
+                res.aborted = speech_interrupted.load();
+                res.stop_reason = res.aborted ? "aborted" : "failed";
+                res.stage = res.aborted ? "interrupted" : "prompt-decode";
+                return false;
+            }
+        }
+    };
+
+    const int64_t prompt_start = speech_now_us();
+    if (!prefill() && !res.aborted) {
+        // The utterance is a stand-alone sequence, but on the shared sequence it
+        // decodes over the positions the chat's own prefix holds, and a cache
+        // busy with the conversation can refuse that. Retry once on empty
+        // memory: the conversation's cells when the utterance has a sequence of
+        // its own, everything else when it does not.
+        std::string first = res.error.substr(0, 240);
+        res.error.clear();
+        if (res.seq_isolated) {
+            llama_memory_seq_rm(llama_get_memory(ctx), SPEECH_SEQ_ID, 0, -1);
+        } else {
+            llama_memory_clear(llama_get_memory(ctx), false);
+        }
+        if (!(mtmd_helper_gen_audio_set_input(gen, &inp) == 0 && prefill())) {
+            res.error = "prefill: " + first + " | after retry: " + res.error.substr(0, 240);
+            return res;
+        }
+        res.error = "prefill retried on empty memory: " + first;
+    }
+    res.prompt_us = speech_now_us() - prompt_start;
+
+    const float * h_state = llama_get_embeddings_ith(ctx, -1);
+    if (h_state == nullptr) {
+        res.stop_reason = "failed";
+        res.stage = "embeddings";
+        return res;
+    }
+    res.stop_reason = "eos";
+    res.stage = "eos";
+    bool stop = false;
+    while (!stop) {
+        const int64_t frame_start = speech_now_us();
+        const float * next_state = nullptr;
+        if (mtmd_helper_gen_audio_step_gen(gen, LLAMA_TOKEN_NULL, h_state, &next_state, &stop) != 0) {
+            res.aborted = speech_interrupted.load();
+            res.stop_reason = res.aborted ? "aborted" : "failed";
+            res.stage = "gen-frame";
+            break;
+        }
+        if (next_state != nullptr) {
+            h_state = next_state;
+        }
+        res.frames++;
+        int32_t sample_rate = 0;
+        const char * data = nullptr;
+        size_t data_len = 0;
+        int64_t n_samples = 0;
+        if (mtmd_helper_gen_audio_get_output(gen, &sample_rate, &data, &data_len, &n_samples) != 0) {
+            res.stop_reason = "failed";
+            res.stage = "gen-output";
+            break;
+        }
+        res.sample_rate = sample_rate;
+        const float * pcm = reinterpret_cast<const float *>(data);
+        emit(pcm, n_samples);
+        const int64_t frame_us = speech_now_us() - frame_start;
+        res.gen_us += frame_us;
+        frame_times.push_back(frame_us);
+        if (stop) {
+            break;
+        }
+        if (speech_interrupted.load()) {
+            res.aborted = true;
+            res.stop_reason = "aborted";
+            res.stage = "interrupted";
+            break;
+        }
+        // A model that switches to text is the interleaved path, not this one.
+        if (mtmd_helper_gen_audio_next_is_text(gen)) {
+            res.stop_reason = "failed";
+            res.stage = "next-is-text";
+            break;
+        }
+        const int64_t cap = (int64_t) ((double) opts.max_seconds * (double) sample_rate);
+        // res.pcm stays empty when streaming, so the length cap reads the
+        // sample count the emit calls accumulated.
+        if (cap > 0 && res.samples >= cap) {
+            res.stop_reason = "max";
+            res.stage = "max-seconds";
+            break;
+        }
+    }
+    if (res.stop_reason != "failed") {
+        // the ISTFT holds back the overlap of the last frame
+        int32_t sample_rate = 0;
+        const char * data = nullptr;
+        size_t data_len = 0;
+        int64_t n_samples = 0;
+        if (mtmd_helper_gen_audio_flush(gen) == 0 &&
+            mtmd_helper_gen_audio_get_output(gen, &sample_rate, &data, &data_len, &n_samples) == 0) {
+            const float * pcm = reinterpret_cast<const float *>(data);
+            emit(pcm, n_samples);
+        }
+    }
+    // Whatever the last chunk did not fill still belongs to this reply: a
+    // caller that is hearing it piece by piece would otherwise lose its tail —
+    // including everything said before an abort.
+    if (!pending.empty()) {
+        on_chunk(std::move(pending), res.sample_rate);
+        pending.clear();
+        res.chunks++;
+    }
+    if (!frame_times.empty()) {
+        // The frame the listener felt, not the average: a run of frames at the
+        // mean and one that stalls for a quarter second sound nothing like each
+        // other and cannot be told apart by `gen_us / frames`.
+        std::sort(frame_times.begin(), frame_times.end());
+        const size_t n = frame_times.size();
+        res.frame_p50_us = frame_times[n / 2];
+        res.frame_p95_us = frame_times[std::min(n - 1, (size_t) ((double) n * 0.95))];
+        res.frame_max_us = frame_times.back();
+    }
+    return res;
+}
+
 }
